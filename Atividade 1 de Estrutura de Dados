1- #include <stdio.h>                                                          
    
    double potencia(double x, int y){
    
    if (y == 0)
    return 1;
    
    return x * potencia(x, y - 1 );
    }
    
int main()
{
    printf ("%.2f", potencia(3 , 3));

    return 0;
}


2- #include <stdio.h>
    
    int fibo(int n){
        
    if (n==0) return 0;
    if (n==1) return 1;
        
    return fibo(n - 1) + fibo(n - 2);
    }
    
int main()
{
    for(int i=0; i<15; i++){
    printf("%d\n", fibo(i));
    }
    
    return 0;
}

